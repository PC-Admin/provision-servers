#### Preseed file for unattended Debian installs of Proxmox VMs (spawn_on_proxmox: 'iso')
#### This is added to the installers initrd by the spawn-server role, edit it to taste.

### Localisation
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us

### Network (DHCP, the static IP is set later by the setup-server role)
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string {{ server_url.split('.')[0] }}
d-i netcfg/get_domain string {{ server_url.split('.', 1)[1] }}
d-i netcfg/hostname string {{ server_url.split('.')[0] }}
d-i hw-detect/load_firmware boolean false

### Mirror
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### Accounts (root only, with a random password, log in with the SSH key)
d-i passwd/root-login boolean true
d-i passwd/make-user boolean false
d-i passwd/root-password-crypted password {{ root_password_hash.stdout }}

### Clock
d-i clock-setup/utc boolean true
d-i time/zone string Australia/Perth
d-i clock-setup/ntp boolean true

### Partitioning (GPT with LVM, a single root volume and no swap, same as the Proxmox templates)
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string lvm
d-i partman-auto-lvm/guided_size string max
d-i partman-auto-lvm/new_vg_name string {{ server_url.split('.')[0] }}-vg
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-basicfilesystems/choose_label string gpt
d-i partman-basicfilesystems/default_label string gpt
d-i partman-partitioning/choose_label string gpt
d-i partman-partitioning/default_label string gpt
d-i partman/choose_label string gpt
d-i partman/default_label string gpt
d-i partman-auto/choose_recipe select root-only
d-i partman-auto/expert_recipe string                         \
      root-only ::                                            \
              1 1 1 free                                      \
                      $bios_boot{ }                           \
                      method{ biosgrub }                      \
              .                                               \
              1024 1024 1024 ext4                             \
                      $primary{ } $bootable{ }                \
                      method{ format } format{ }              \
                      use_filesystem{ } filesystem{ ext4 }    \
                      mountpoint{ /boot }                     \
              .                                               \
              1000 10000 -1 ext4                              \
                      $lvmok{ } lv_name{ root }               \
                      method{ format } format{ }              \
                      use_filesystem{ } filesystem{ ext4 }    \
                      mountpoint{ / }                         \
              .
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Apt (disable the CD-ROM entries, the ISO is ejected after the install)
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/cdrom/set-next boolean false
d-i apt-setup/cdrom/set-failed boolean false
d-i apt-setup/disable-cdrom-entries boolean true
d-i apt-setup/non-free-firmware boolean true

### Packages (qemu-guest-agent, sudo and python3 are needed by this playbook)
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string qemu-guest-agent sudo python3
popularity-contest popularity-contest/participate boolean false

### Boot loader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string default

### Finish (add the SSH key for root, then power off so the installer can be removed from the VM)
d-i preseed/late_command string                                                         \
    mkdir -p -m 700 /target/root/.ssh;                                                  \
    echo {{ public_ssh_key | quote }} > /target/root/.ssh/authorized_keys;              \
    chmod 600 /target/root/.ssh/authorized_keys;                                        \
    echo 'PasswordAuthentication no' > /target/etc/ssh/sshd_config.d/provision-servers.conf
d-i cdrom-detect/eject boolean false
d-i finish-install/reboot_in_progress note
d-i debian-installer/exit/poweroff boolean true
